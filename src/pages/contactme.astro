---
import { Mail } from "lucide-react";
import CopyButton from "../components/CopyButton.astro";
import PageHero from "../components/PageHero.astro";
import SectionHeader from "../components/SectionHeader.astro";
import Seo from "../components/Seo.astro";
import SocialList from "../components/SocialList.astro";
import { buttonVariants } from "../components/ui/button";
import { EMAIL } from "../data/site";
import Layout from "../layouts/Layout.astro";
import { padTwo } from "../lib/utils";

const engagements = [
  {
    title: "Performance and cost for backend services",
    body: "Profiling hot paths, finding where the money goes, and making a service cheaper to run without giving back latency.",
    evidence: "systems at 50M+ requests/day",
  },
  {
    title: "Observability and reliability for payment-grade systems",
    body: "Tracing, alerting, and failure-mode reviews for services where a dropped request is a customer's money.",
    evidence: "UPI payments at Amazon",
  },
  {
    title: "Node.js runtime internals and debugging",
    body: "Event loop stalls, memory growth, and long-lived WebSocket traffic, traced down to what the runtime is actually doing.",
    evidence: "Node.js collaborator emeritus",
  },
  {
    title: "Mentoring and open source onboarding",
    body: "Helping engineers find their way around a large codebase and land their first upstream patches.",
    evidence: "GSoC 2018, Code-in mentor 2017 and 2018",
  },
];
---

<Layout>
  <Seo
    slot="header"
    seo={{
      title: "Collaborate",
      description:
        "Work with Yash Ladha on backend performance and cost, observability for payment systems, Node.js internals, and mentoring.",
    }}
  />

  <PageHero
    crumbs={[{ label: "collaborate" }]}
    title="Working on something underneath?"
    muted=" Let's talk."
    lead="I am happiest on runtimes, infrastructure, and the failure modes in between. These are the conversations where I can be most useful."
  />

  <div class="grid gap-6 pb-16 lg:grid-cols-[minmax(0,1.6fr)_minmax(0,1fr)] lg:items-start">
    <section class="animate-enter" style="--i: 1">
      <SectionHeader title="What I can help with" />
      <ol class="rail-list">
        {engagements.map((e, i) => (
          <li class="grid gap-x-5 gap-y-1 px-5 py-5 sm:grid-cols-[2rem_1fr]">
            <span class="pt-0.5 font-mono text-xs tabular-nums text-muted-foreground">{padTwo(i + 1)}</span>
            <div>
              <h3 class="font-medium tracking-tight">{e.title}</h3>
              <p class="mt-1 text-sm leading-relaxed text-muted-foreground">{e.body}</p>
              <p class="mt-3 font-mono text-2xs text-muted-foreground">
                <span class="text-brand">#</span> {e.evidence}
              </p>
            </div>
          </li>
        ))}
      </ol>
    </section>

    <aside class="animate-enter lg:pt-12" style="--i: 2">
      <div class="rounded-xl border bg-card p-5">
        <p class="font-mono text-xs text-muted-foreground">
          <span class="text-brand">$</span> mail {EMAIL}
        </p>
        <p class="mt-4 text-sm leading-relaxed text-muted-foreground">
          Email is the fastest way to reach me. A few lines on the system and the problem is plenty to start.
        </p>
        <div class="mt-5 flex flex-wrap gap-2">
          <a href={`mailto:${EMAIL}`} class={buttonVariants()}>
            <Mail />
            Write an email
          </a>
          <CopyButton text={EMAIL} />
        </div>
      </div>

      <SocialList class="mt-4" />
    </aside>
  </div>
</Layout>
