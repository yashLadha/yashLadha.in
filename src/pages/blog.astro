---
import { ArrowRight } from "lucide-react";
import Layout from "../layouts/Layout.astro";
import PageHero from "../components/PageHero.astro";
import PostRow from "../components/PostRow.astro";
import Seo from "../components/Seo.astro";
import { loadPosts } from "../lib/posts";

const posts = await loadPosts();
const [latest, ...older] = posts;
const totalMinutes = posts.reduce((sum, post) => sum + post.minutes, 0);
---

<Layout>
  <Seo
    slot="header"
    seo={{
      title: "Writing",
      description: "Notes on runtimes, infrastructure, benchmarks, and developer tooling by Yash Ladha.",
    }}
  />

  <div class="mx-auto max-w-4xl pb-16">
    <PageHero
      crumbs={[{ label: "writing" }]}
      title="Writing"
      lead="Measured comparisons, tooling setups, and notes on how the systems underneath actually behave."
    >
      <p class="mt-4 font-mono text-xs text-muted-foreground">
        {posts.length} posts, {totalMinutes} min total
      </p>
    </PageHero>

    {latest ? (
      <div class="animate-enter space-y-6" style="--i: 2">
        <a
          href={latest.url}
          class="group shadow-panel grid overflow-hidden rounded-xl border bg-card transition-colors hover:border-foreground/25 md:grid-cols-[1.1fr_1fr]"
        >
          <div class="flex flex-col gap-4 p-6 sm:p-8">
            <p class="font-mono text-xs text-muted-foreground">
              <span class="text-brand">latest</span>
              <span aria-hidden="true"> · </span>
              <time datetime={latest.isoDate}>{latest.date}</time>
              <span aria-hidden="true"> · </span>
              {latest.minutes} min read
            </p>
            <h2 class="text-2xl leading-snug font-semibold tracking-tight md:text-3xl">{latest.title}</h2>
            <p class="leading-relaxed text-muted-foreground">{latest.description}</p>
            <span class="mt-auto inline-flex items-center gap-1.5 pt-2 text-sm font-medium">
              Read the post
              <ArrowRight className="h-4 w-4 transition-transform group-hover:translate-x-0.5" />
            </span>
          </div>
          {latest.heroImage && (
            <div class="aspect-[4/3] overflow-hidden border-t bg-muted md:aspect-auto md:border-t-0 md:border-l">
              <img
                src={latest.heroImage}
                alt=""
                class="h-full w-full object-cover transition-transform duration-500 group-hover:scale-[1.03]"
              />
            </div>
          )}
        </a>

        {older.length > 0 && (
          <ol class="rail-list">
            {older.map((post) => (
              <li>
                <PostRow post={post} descriptionLines={2} />
              </li>
            ))}
          </ol>
        )}
      </div>
    ) : (
      <p class="rounded-xl border bg-card p-8 text-muted-foreground">No posts yet.</p>
    )}
  </div>
</Layout>
