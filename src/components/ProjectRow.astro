---
import { ArrowUpRight } from "lucide-react";
import { githubUrl, type Project } from "../data/projects";

type Props = { project: Project };

const { project } = Astro.props;
const [owner, name] = project.slug.split("/");
---

<!-- Sized by the list it sits in, not the viewport, so it fits both the full-width projects page and the home page column. -->
<div class="@container">
  <a
    href={githubUrl(project.slug)}
    target="_blank"
    rel="noreferrer"
    class="rail-row group grid gap-x-6 gap-y-1.5 px-5 py-4 @xl:grid-cols-[11rem_1fr] @5xl:grid-cols-[17rem_1fr_12.5rem] @5xl:items-center"
  >
    <span class="flex min-w-0 font-mono text-sm">
      <span class="text-muted-foreground">{owner}/</span>
      <span class="truncate font-medium text-foreground">{name}</span>
    </span>
    <span class="text-sm leading-relaxed text-muted-foreground">
      {project.role && (
        <span class="mr-2 rounded bg-accent px-1.5 py-0.5 font-mono text-2xs text-foreground">{project.role}</span>
      )}
      {project.description}
    </span>
    <span class="flex items-center gap-3 font-mono text-xs whitespace-nowrap text-muted-foreground @xl:col-start-2 @5xl:col-start-auto">
      {project.languages.join(" · ")}
      <ArrowUpRight className="ml-auto h-4 w-4 transition group-hover:-translate-y-0.5 group-hover:translate-x-0.5 group-hover:text-foreground" />
    </span>
  </a>
</div>
